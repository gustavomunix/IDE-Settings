// Trecho para colar em ~/.config/opencode/opencode.jsonc.
// Fonte: opencode.jsonc de 2026-11-11. Preços e status vivem em docs/models.md.
// Regra: input <= $1,50/1M e output <= $2,50/1M.
// Shims (claude-agent, claude-luciana, antigravity-shim) são assinatura, não $0.
// OpenCode não tem política por modelo; o bloqueio é "disabled": true.
// opencode-go/gemini-4-argon ($2/$10) fica desativado. Use antigravity-shim/gemini-4-argon-high.
{
  "model": "opencode-go/deepseek-v4.1-flash",
  "agents": {
    "plan": {
      "model": "claude-agent/opus#high"
    },
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash#high"
    },
    "explore": {
      "model": "opencode-go/glm-5.3-flash#high"
    }
  },
  "providers": {
    "meta": {
      "models": {
        "muse-spark-1.1": {
          "disabled": true
        },
        "muse-spark-1.2": {
          "disabled": true
        },
        "muse-wonder-1.0": {
          "disabled": true
        },
        "muse-spark-1.2-contributor": {
          "disabled": true
        },
        "muse-spark-1.3": {
          "disabled": true
        },
        "muse-ember-1.0": {
          "disabled": true
        }
      }
    },
    "claude-luciana": {
      "name": "Claude (Luciana)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8125/v1",
        "apiKey": "dummy"
      },
      "models": {
        "claude-opus-5-5": {
          "modelID": "claude-opus-5-5",
          "name": "Claude Opus 5.5",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "capabilities": {
            "tools": true,
            "temperature": true,
            "input": [
              "text",
              "image"
            ]
          }
        },
        "claude-opus-5-5-fast": {
          "modelID": "claude-opus-5-5:fast",
          "name": "Claude Opus 5.5 Fast",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "capabilities": {
            "tools": true,
            "temperature": true,
            "input": [
              "text",
              "image"
            ]
          }
        },
