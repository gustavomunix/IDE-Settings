{
  // ── Geral ──────────────────────────────────────────
  "base_keymap": "VSCode",
  "confirm_quit": true,
  "session": {
    "trust_all_worktrees": true
  },

  // ── Aparência ──────────────────────────────────────
  "theme": {
    "mode": "system",
    "light": "JetBrains Light",
    "dark": "JetBrains Dark"
  },
  "icon_theme": {
    "mode": "system",
    "light": "JetBrains New UI Icons (Light)",
    "dark": "JetBrains New UI Icons (Dark)"
  },
  "ui_font_family": "IBM Plex Sans",
  "ui_font_size": 16,
  "buffer_font_family": "Lilex",
  "markdown_preview": {
    "font_family": "IBM Plex Sans",
    "code_font_family": "Lilex"
  },

  // ── Editor ─────────────────────────────────────────
  "tab_size": 2,
  "soft_wrap": "editor_width",
  "line_ending": "prefer_lf",

  // ── Layout dos painéis ─────────────────────────────
  "project_panel": {
    "dock": "left",
    "folder_indicator": "chevron"
  },

  // ── Git ────────────────────────────────────────────
  "git": {
    "inline_blame": {
      "location": "status_bar"
    }
  },

  // ── Linguagens ─────────────────────────────────────
  "languages": {
    "PHP": {
      "tab_size": 4
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": "language_server"
    }
  },

  // ── Privacidade ────────────────────────────────────
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
