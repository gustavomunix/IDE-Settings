{
  // ── Geral ──────────────────────────────────────────
  "base_keymap": "VSCode",

  // ── Aparência ──────────────────────────────────────
  "theme": {
    "mode": "system",
    "light": "JetBrains Light",
    "dark": "JetBrains Dark"
  },
  "icon_theme": {
    "mode": "system",
    "light": "JetBrains New UI Icons (Light)",
    "dark": "JetBrains New UI Icons (Dark)"
  },
  "ui_font_family": "IBM Plex Sans",
  "ui_font_size": 16,
  "buffer_font_family": "Lilex",
  "buffer_font_size": 16,
  "markdown_preview": {
    "font_family": "IBM Plex Sans",
    "code_font_family": "Lilex"
  },
  "minimap": {
    "show": "always"
  },

  // ── Editor ─────────────────────────────────────────
  "tab_size": 2,
  "soft_wrap": "editor_width",
  "line_ending": "prefer_lf",

  // ── Layout dos painéis ─────────────────────────────
  "project_panel": {
    "dock": "left",
    "folder_indicator": "chevron"
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": true
    },
    "show_count_badge": false,
    "flexible": true,
    "dock": "right",
    "starts_open": true
  },

  // ── Git ────────────────────────────────────────────
  "git": {
    "inline_blame": {
      "location": "status_bar"
    }
  },

  // ── Linguagens ─────────────────────────────────────
  "languages": {
    "PHP": {
      "tab_size": 4
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": "language_server"
    }
  },

  // ── Agentes ────────────────────────────────────────
  "agent_servers": {
    "grok-build": { "type": "registry" },
    "cursor": { "type": "registry" },
    "codex-acp": { "type": "registry" },
    "claude-acp": { "type": "registry" }
  },

  // ── Privacidade ────────────────────────────────────
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
